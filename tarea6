    <h3>Formulario con campo de entrada de varias lineas</h3>
        <form action="validar.js" method="post">
            <label for="name">Nombre:</label>
            <input type="text" id="name" name="name" required>
            <br><br>
            <label for="opinion">Comentario:</label>
            <textarea name="opinion" id="opinion" placeholder="Tu opinion es importante:" required rows="5"  cols="50"></textarea>
            <br><br>
            <button type="submit"> Enviar comentario</button>

            <hr>

            <h3>Formulario con una lista despegable de opciones</h3>
            <form action="/opciones" method="post">
                <label for="bebidas">Bebidas:</label>
                <select name="bebidas" id="bebidas">
                    <option value="" disabled selected>Selecciona una bebida</option>
                    <option value="coca_cola">Coca-Cola</option>
                    <option value="pepsi">Pepsi</option>
                    <option value="boing">Boing</option>
                    <option value="jarritos">Jarritos</option>

                </select>
                <br>
                <label for="postres">Postres:</label>
                <select name="postres" id="postres">
                    <option value="" disabled selected>Selecciona un postre</option>
                    <option value="pay_limon">Pay de limon</option>
                    <option value="pay_fresa">Pay de fresa</option>
                    <option value="flan">Flan</option>
                    <option value="arroz_leche">Arroz con Leche</option>
                </select>
                <br>
                <input type ="submit">
                </form>
            
                <h3>Formulario con distintos campos de datos</h3>
                <form action="datos.php" method="post">
                    <fieldset>
                        <legend>Nombre Completo</legend>
                        <label for="nombre">Nombre</label>
                        <input type="text" id="nombre" name="nombre" required>
                        <br>
                        <label for="ap_paterno">Ap. Paterno</label>
                        <input type="text" id="ap_paterno" name="ap_paterno" required>
                        <br>
                        <label for="ap_materno">Ap. Materno</label>
                        <input type="text" id="ap_materno" name="ap_materno" required>
                    </fieldset>
                    <fieldset>
                        <legend>Otros Datos</legend>
                        <label for="fecha_nacimiento"> Fecha de Nacimiento</label>
                        <input type="date" id="fecha_nacimiento" name="fecha_nacimiento" required>
                        <br>
                        <label for="edad">Edad</label>
                        <input type="numbre" id="edad" name="edad" required min="18" max="90">
                        <br>
                        <label for="numero_cuenta">Numero de Cuenta</label>
                        <input type="text" id="numero_cuenta" name="numero_cuenta" required pattern="[0-9]{9}">
                        <br>
                        <label for="email">Correo Electronico</label>
                        <input type="email" id="email" name="email" required>
                    </fieldset>

                    <fieldset>
                    <legend>Direccion: </legend>
                    <label for="Calle">Calle</label>
                    <input type="text" name="Calle" id="Calle" required>
                    <br>
                    <label for="Colonia">Colonia</label>
                    <input type="text" name="Colonia" id="Colonia" required ">
                    <br>
                    <label for="Manzana">Manzana</label>
                    <input type="number" name="Manzana" id="Manzana" required pattern="[0-9]{2}">
                    <br>
                    <label for="Codigo_Postal">Codigo Postal</label>
                    <input type="text" name="Codigo_Postal" id="Codigo_Postal" required>
                    <br>
                </fieldset>
                <button type="submit">CARGAR</button>
                </form>

